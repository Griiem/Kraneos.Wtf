local BASE_URL = "https://github.com/Griiem/Kraneos.Wtf"

local function loadTab(name)
    local url = BASE_URL .. name .. ".luau" .. "?t=" .. tostring(os.time())
    local ok, err = pcall(function()
        local src = game:HttpGet(url)
        local chunk = loadstring(src)
        if not chunk then
            warn("[Kraneos] Compilation failed: " .. name); return 
        end
        chunk()(Window, WindUI)
    end)
    if not ok then warn("[Kraneos] Error loading tab '" .. name .. "': " .. tostring(err)) end
end

